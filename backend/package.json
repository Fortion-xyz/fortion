{
  "name": "backend",
  "private": true,
  "type": "module",
  "bin": {
    "fortion-mcp": "./dist/mcp/index.js"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/server.ts",
    "dev:keeper": "tsx watch --env-file-if-exists=.env src/keeper/index.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "hono": "^4.13.9",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

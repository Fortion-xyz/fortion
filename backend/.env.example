BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
PORT=4000
# Binance Web3 API: create a project at https://web3.binance.com/en/dev-portal/project
BINANCE_WEB3_API_URL=https://web3.binance.com/build
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Comma-separated wallets the keeper guards
WATCH_ADDRESSES=
# Earnings come from the Nasdaq calendar automatically; add or override dates here: TICKER=ISO-8601, comma-separated
CORPORATE_ACTIONS=
# Where policies + the Guard's event log are stored (JSON). Default: backend/data
# FORTION_DATA_DIR=
# Signing: 1 = the keeper / CLI --yes / MCP confirm may sign through the Agentic Wallet signed in on
# this host (`pnpm fortion signin`). Anything else = dry run (simulate + log only).
EXECUTE=0
# Operator token (≥ 16 chars) required for policy writes, which steer what the keeper signs. Unset = writes off.
# The frontend sends it server-side as API_TOKEN. Generate one: openssl rand -hex 24
FORTION_API_TOKEN=
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:3000
